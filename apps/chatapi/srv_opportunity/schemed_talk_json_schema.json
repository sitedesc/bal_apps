{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemedtalk-editor.schema.json",
  "title": "SchemedTalk",
  "$ref": "#/$defs/SchemedTalkNode",
  "$defs": {
    "PrimitiveScalar": {
      "type": ["string", "number", "boolean"]
    },
    "PrimitiveScalarOrArray": {
      "anyOf": [
        { "$ref": "#/$defs/PrimitiveScalar" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/PrimitiveScalar" }
        }
      ]
    },
    "JsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "JsonValueNoNull": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValueNoNull" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "ManagedService": {
      "type": "string",
      "enum": [
        "identity",
        "selling",
        "gateway",
        "salesforce",
        "srv_opportunity",
        "openai"
      ]
    },
    "OptionalHeaders": {
      "type": "string",
      "minLength": 1
    },
    "OptionalParameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/PrimitiveScalarOrArray"
      }
    },
    "OptionalBody": {
      "$ref": "#/$defs/JsonValueNoNull"
    },
    "UntypedDraftNode": {
      "type": "object",
      "description": "UntypedDraftNode — Temporary draft node accepted by the editor before a concrete type is chosen.",
      "additionalProperties": false,
      "not": {
        "required": ["type"]
      },
      "properties": {
        "description": {
          "type": "string"
        }
      }
    },
    "SchemedTalk": {
      "type": "object",
      "description": "SchemedTalk — Root SchemedTalk container.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "SchemedTalk"
        },
        "description": {
          "type": "string"
        },
        "talkScheme": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchemedTalkNode" }
        }
      }
    },
    "SchemedTalkDoc": {
      "type": "object",
      "description": "SchemedTalkDoc — A SchemedTalkDoc request can be used to describe a schemed talk or a part of it. The schemed talk processor simply returns its textual content.",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "const": "SchemedTalkDoc"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "GET": {
      "type": "object",
      "description": "GET — Executes an openflex or salesforce HTTP GET request.",
      "additionalProperties": false,
      "required": ["type", "service"],
      "properties": {
        "type": {
          "const": "GET"
        },
        "service": {
          "$ref": "#/$defs/ManagedService"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        }
      }
    },
    "POST": {
      "type": "object",
      "description": "POST — Executes an openflex or salesforce HTTP POST request.",
      "additionalProperties": false,
      "required": ["type", "service"],
      "properties": {
        "type": {
          "const": "POST"
        },
        "service": {
          "$ref": "#/$defs/ManagedService"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        }
      }
    },
    "PUT": {
      "type": "object",
      "description": "PUT — Executes an openflex or salesforce HTTP PUT request.",
      "additionalProperties": false,
      "required": ["type", "service"],
      "properties": {
        "type": {
          "const": "PUT"
        },
        "service": {
          "$ref": "#/$defs/ManagedService"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        }
      }
    },
    "PATCH": {
      "type": "object",
      "description": "PATCH — Executes an openflex or salesforce HTTP PATCH request.",
      "additionalProperties": false,
      "required": ["type", "service"],
      "properties": {
        "type": {
          "const": "PATCH"
        },
        "service": {
          "$ref": "#/$defs/ManagedService"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        }
      }
    },
    "ProvidersEntities": {
      "type": "object",
      "description": "ProvidersEntities — Executes openflex POST endpoint /providers/entities.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "ProvidersEntities"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "id": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "AuthProvidersSign_in": {
      "type": "object",
      "description": "AuthProvidersSign_in — Executes openflex POST endpoint /auth/providers/sign-in.",
      "additionalProperties": false,
      "required": ["type", "entityId"],
      "properties": {
        "type": {
          "const": "AuthProvidersSign_in"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "entityId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "AuthUsersSign_in": {
      "type": "object",
      "description": "AuthUsersSign_in — Executes openflex POST endpoint /auth/users/sign-in.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "AuthUsersSign_in"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "id": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "mfaToken": {
          "type": "string"
        }
      }
    },
    "AuthProvidersPassword": {
      "type": "object",
      "description": "AuthProvidersPassword — Executes openflex POST endpoint /auth/providers/password.",
      "additionalProperties": false,
      "required": ["type", "currentPassword", "newPassword"],
      "properties": {
        "type": {
          "const": "AuthProvidersPassword"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "currentPassword": {
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      }
    },
    "Users": {
      "type": "object",
      "description": "Users — Executes openflex GET endpoint /users. Supported parameters are pointOfSaleIds and groupTypes.",
      "additionalProperties": false,
      "required": ["type", "pointOfSaleIds", "groupTypes"],
      "properties": {
        "type": {
          "const": "Users"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "pointOfSaleIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "groupTypes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CreateOpportunity": {
      "type": "object",
      "description": "CreateOpportunity — Creates an openflex opportunity from its 'opportunity' property and executes the associated processing sequence.",
      "additionalProperties": false,
      "required": ["type", "opportunity"],
      "properties": {
        "type": {
          "const": "CreateOpportunity"
        },
        "description": {
          "type": "string"
        },
        "opportunity": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "SFAuth2Token": {
      "type": "object",
      "description": "SFAuth2Token — Executes salesforce POST endpoint /services/oauth2/token.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "SFAuth2Token"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        }
      }
    },
    "SOApiLoginCheck": {
      "type": "object",
      "description": "SOApiLoginCheck — Executes service opportunity POST endpoint /api/login_check.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "SOApiLoginCheck"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "SOApiOpportunities": {
      "type": "object",
      "description": "SOApiOpportunities — Executes service opportunity POST endpoint /api/opportunities.",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": {
          "const": "SOApiOpportunities"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      }
    },
    "OARequest": {
      "type": "object",
      "description": "OARequest — Executes service openai POST endpoint /chat/completions with its prompt property as the prompt text sent to OpenAI.",
      "additionalProperties": false,
      "required": ["type", "prompt"],
      "properties": {
        "type": {
          "const": "OARequest"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/OptionalHeaders"
        },
        "parameters": {
          "$ref": "#/$defs/OptionalParameters"
        },
        "body": {
          "$ref": "#/$defs/OptionalBody"
        },
        "prompt": {
          "$ref": "#/$defs/JsonValueNoNull"
        },
        "prePromptFile": {
          "type": "string"
        }
      }
    },
    "Memorize": {
      "type": "object",
      "description": "Memorize — Memorizes a JSON value of the last response.",
      "additionalProperties": false,
      "required": ["type", "asWhat"],
      "properties": {
        "type": {
          "const": "Memorize"
        },
        "description": {
          "type": "string"
        },
        "asWhat": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "integer" }
                ]
              }
            }
          ]
        }
      }
    },
    "IsSubset": {
      "type": "object",
      "description": "IsSubset — Evaluates whether the second value is a subset of the first.",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": {
          "const": "IsSubset"
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        "true": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchemedTalkNode" }
        },
        "false": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchemedTalkNode" }
        }
      }
    },
    "Equal": {
      "type": "object",
      "description": "Equal — Evaluates whether the second value is equal to the first.",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": {
          "const": "Equal"
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/JsonValue" }
        },
        "true": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchemedTalkNode" }
        },
        "false": {
          "type": "array",
          "items": { "$ref": "#/$defs/SchemedTalkNode" }
        }
      }
    },
    "Sleep": {
      "type": "object",
      "description": "Sleep — Stops execution for the specified number of seconds.",
      "additionalProperties": false,
      "required": ["type", "seconds"],
      "properties": {
        "type": {
          "const": "Sleep"
        },
        "description": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        }
      }
    },
    "SchemedTalkNode": {
      "oneOf": [
        { "$ref": "#/$defs/UntypedDraftNode" },
        { "$ref": "#/$defs/SchemedTalk" },
        { "$ref": "#/$defs/SchemedTalkDoc" },
        { "$ref": "#/$defs/GET" },
        { "$ref": "#/$defs/POST" },
        { "$ref": "#/$defs/PUT" },
        { "$ref": "#/$defs/PATCH" },
        { "$ref": "#/$defs/ProvidersEntities" },
        { "$ref": "#/$defs/AuthProvidersSign_in" },
        { "$ref": "#/$defs/AuthUsersSign_in" },
        { "$ref": "#/$defs/AuthProvidersPassword" },
        { "$ref": "#/$defs/Users" },
        { "$ref": "#/$defs/CreateOpportunity" },
        { "$ref": "#/$defs/SFAuth2Token" },
        { "$ref": "#/$defs/SOApiLoginCheck" },
        { "$ref": "#/$defs/SOApiOpportunities" },
        { "$ref": "#/$defs/OARequest" },
        { "$ref": "#/$defs/Memorize" },
        { "$ref": "#/$defs/IsSubset" },
        { "$ref": "#/$defs/Equal" },
        { "$ref": "#/$defs/Sleep" }
      ]
    }
  }
}