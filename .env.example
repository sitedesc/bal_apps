# Copier en .env (non versionné). Valeurs : bloc "## chatapi conf" du ~/.profile de l'hôte d'origine (itdoc_srv).
SALESFORCE_TEST_AUTH='{ "username": "...", "password": "...", "client_id": "...", "client_secret": "..." }'
OPENFLEX_TEST_AUTH='{ "FR": { "id": "...", "password": "..." }, "IT": { "id": "...", "password": "..." } }'
SRV_OPPORTUNITY_TEST_AUTH='{"url": "http://localhost:3333", "username": "...", "password": "..."}'

# Ports publiés en dev (ignorés en prod)
CHATAPI_WEB_PORT=8090
CHATAPI_API_PORT=9090
# URL que Swagger UI propose pour "Try it out" (bloc servers du contrat) : celle du nginx de la stack
OPENAPI_SERVER=http://localhost
OPENAPI_PORT=8090

# Déploiement OVH it-doc (scripts/deploy-ovh.sh)
CHATAPI_HOST=chatapi.sitems.org
OVH_SSH=deployer@135.125.75.39
OVH_DIR=/srv/bal_apps
